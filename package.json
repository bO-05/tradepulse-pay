{
  "name": "tradepulse-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy": "npx @convex-dev/static-hosting upload --dist dist",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:site": "npx @convex-dev/static-hosting upload --dist dist",
    "webhook:setup": "node scripts/setup-agentmail-webhook.mjs",
    "benchmark": "node scripts/run-real-world-benchmark.mjs",
    "evals": "node scripts/run-expert-evals.mjs",
    "eval:payapps": "node scripts/qa/pay-app-review-scorecard.mjs",
    "test": "vitest run",
    "a11y": "node scripts/qa/a11y-six-screens.mjs",
    "verify:docs": "node scripts/tools/check-docs-links.mjs docs README.md && node scripts/tools/reorder-hackathon-log.mjs --check",
    "verify:reports": "node scripts/qa/render-audit-reports.mjs",
    "verify:guards": "node scripts/tools/guard-audit.mjs",
    "verify:agents": "node scripts/tools/check-agents-md.mjs",
    "judge-demo:history": "node scripts/qa/judge-demo-history-browser.mjs",
    "judge-demo:fixture": "node scripts/qa/judge-demo-fixture-browser.mjs",
    "release:hosted-gc": "node scripts/qa/release-hosted-gc-browser.mjs --url https://tradepulse-pay.pages.dev --no-fresh-run",
    "release:hosted-gc:canonical": "node scripts/qa/release-hosted-gc-browser.mjs --url https://tradepulse-pay.asynchronope.tech --no-fresh-run",
    "smoke:live": "node scripts/qa/live-smoke.mjs"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@ai-sdk/anthropic": "4.0.72",
    "@ai-sdk/mistral": "4.0.57",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.1",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@onkernel/sdk": "0.119.0",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@paypal/react-paypal-js": "10.6.0",
    "@types/pako": "^3.0.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "ai": "7.0.128",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.475.0",
    "openai": "^4.86.0",
    "pako": "^3.0.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "^3.0.1",
    "tslib": "2.8.1",
    "write-excel-file": "^4.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.58",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "unpdf": "^1.8.1",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
