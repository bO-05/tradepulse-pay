# ==============================================================================
# TradePulse Pay: environment variable names (no secret values here)
# ==============================================================================
# Real values live outside the repo. Convex deployment variables are set with
#   bash scripts/sync-convex-env.sh            (reads SECRETS_FILE, prints names only)
# or one at a time with
#   printf '%s' "$VALUE" | npx convex env set NAME
# Only non-secret literals are filled in below.

# ------------------------------------------------------------------------------
# 1. Frontend (Vite) variables, placed in .env.local (gitignored)
# Only public values may go here: they are bundled into the browser.
# ------------------------------------------------------------------------------
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# PayPal REST app client id (public by design)
VITE_PAYPAL_CLIENT_ID=
# AG Studio license key (client-side by design)
VITE_AG_STUDIO_LICENSE_KEY=
# Written by `npx convex dev`, e.g. dev:<deployment-name>
CONVEX_DEPLOYMENT=

# ------------------------------------------------------------------------------
# 2. Local tooling only (not set on the deployment)
# ------------------------------------------------------------------------------
# Deploy key used by the Convex CLI to target the deployment
CONVEX_DEPLOY_KEY=
# Source of the AG Studio license copied into VITE_AG_STUDIO_LICENSE_KEY
AG_STUDIO_LICENSE_KEY=
# AgentID CLI project binding
AGENTID_PROJECT_BINDING=

# ------------------------------------------------------------------------------
# 3. Convex deployment variables (npx convex env set)
# ------------------------------------------------------------------------------

# Anthropic (pay-app review, pay agent, AG Studio proxy)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# PayPal sandbox accounts (demo GC buyer, subcontractor payees, owner payer)
PAYPAL_SANDBOX_GC_BUYER_EMAIL=
PAYPAL_SANDBOX_SUB1_EMAIL=
PAYPAL_SANDBOX_SUB2_EMAIL=
PAYPAL_SANDBOX_SUB3_EMAIL=
PAYPAL_SANDBOX_OWNER_EMAIL=

# KERNEL browsers (CSLB license checks)
KERNEL_API_KEY=

# Convex Auth. JWT_PRIVATE_KEY and JWKS are generated by the Convex Auth setup.
# SITE_URL must equal the browser origin used for sign-in.
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=http://localhost:3150

# AgentID OIDC provider (billing-agent sign-in)
AUTH_AGENTID_ID=
AUTH_AGENTID_SECRET=

# Firecrawl (subcontractor discovery). Required by the firecrawl component;
# every push fails until it is set.
FIRECRAWL_API_KEY=
# optional: Firecrawl component webhook secret, declared optional in convex/convex.config.ts
FIRECRAWL_WEBHOOK_SECRET=
# optional: not read by convex/ functions or passed to the Firecrawl component
FIRECRAWL_API_URL=

# AgentMail (all sends go through convex/lib/mailer.ts; inbound via /agentmail/webhook)
AGENTMAIL_API_KEY=
# optional: inbound AgentMail webhook returns 503 until it is set; scripts/setup-agentmail-webhook.mjs sets it per deployment
AGENTMAIL_WEBHOOK_SECRET=
# optional: defaults to the public AgentMail API URL in convex/agentmailApi.ts
AGENTMAIL_BASE_URL=
# optional: daily send budget for the mailer; defaults to 30 (prod). Dev uses 60 (scripts/sync-convex-env.sh)
EMAIL_DAILY_BUDGET=

# Provided by Convex on every deployment (the .convex.site URL). Read by convex/http.ts;
# do not set it yourself. scripts/setup-agentmail-webhook.mjs requires it in the shell.
CONVEX_SITE_URL=

# Optional alternative model providers used by the existing leveling router
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
OPENAI_API_KEY=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
OPENAI_MODEL=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GEMINI_API_KEY=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GEMINI_MODEL=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
VERTEX_PROJECT_ID=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
VERTEX_LOCATION=us-central1
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
VERTEX_MODEL=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
VERTEX_ACCESS_TOKEN=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
VERTEX_API_KEY=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GCP_PROJECT=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GOOGLE_CLOUD_PROJECT=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GOOGLE_CLOUD_REGION=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GCLOUD_ACCESS_TOKEN=
# optional: alternative provider for the existing leveling router; unset, the router uses Anthropic
GOOGLE_ACCESS_TOKEN=
